# Proposed isolated Dataset-storage profile. NOT applied to any Space.
# Supply actual existing private Dataset IDs; this profile never creates repos.
HF_SOURCE_REPO=
HF_WORK_REPO=
HF_OUTPUT_REPO=
# HF_TOKEN must come from a secure credential binding, never this file/YAML/browser.
HF_HUB_OFFLINE=0
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_XET=1
TRANSFORMERS_OFFLINE=1
ATK_DATA_ROOT=/data
ATK_PREPARATION_ENABLED=true
ATK_DATASET_PERSISTENCE_ENABLED=true
# Remains false until separate authorization; loading this template cannot write.
ATK_DATASET_PERSISTENCE_WRITE_APPROVED=false
ATK_JOB_EXECUTION_ENABLED=false
ATK_HF_RECOVERY_ENABLED=false
HF_AUTO_RESUME=false
OCR_ENABLE_GPU=false
OCR_ENABLE_GPU_OVERFLOW=false
OCR_ALLOW_EXTERNAL_CPU_D0=false
OCR_ALLOW_EXTERNAL_CPU_D1=false
OCR_ALLOW_EXTERNAL_CPU_D2=false
# Classification is enforced as D0 in the API, not relaxed through a flag.
# No automated publication/release service is activated; automated_release_eligible=false.
