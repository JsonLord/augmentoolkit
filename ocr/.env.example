# Securely provision values, do not commit .env or print the process environment.
OCR_DISPATCHER_TOKEN=
OCR_CPU_AUTH_TOKEN=
OCR_MODELS_DIR=/opt/ocr-models
# Empty means trusted local CPU. Remote URL must be HTTPS.
OCR_CPU_URL=
OCR_MIN_SENSITIVITY=D2
OCR_ALLOW_EXTERNAL_CPU_D0=true
OCR_ALLOW_EXTERNAL_CPU_D1=false
OCR_ALLOW_EXTERNAL_CPU_D2=false
OCR_ENABLE_GPU=false
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
OCR_GPU_MODEL=alias-ocr
OCR_CPU_CONCURRENCY=1
OCR_GPU_CONCURRENCY=2
OCR_ENABLE_GPU_OVERFLOW=false
OCR_OVERFLOW_BENCHMARK_QUALIFIED=false
OCR_QUALITY_DUAL_RUN=false
OCR_MAX_UPLOAD_MIB=25
OCR_MAX_PAGES=100
OCR_MAX_PIXELS=20000000
OCR_JOB_TTL_MIN=30
